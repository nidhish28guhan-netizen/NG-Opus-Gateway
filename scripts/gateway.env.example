# NG-Opus-Gateway - gateway environment, sourced by the installers.
# Copy this to gateway.env and fill in your own values. gateway.env is git-ignored.

# The key your upstream provider expects.
NG_UPSTREAM_TOKEN="tj_PASTE_YOUR_TOKEN_HERE"

# The upstream model name, exactly as the provider lists it in /v1/models.
NG_UPSTREAM_MODEL="PASTE_UPSTREAM_MODEL_NAME"

# The provider's OpenAI-compatible base URL.
NG_UPSTREAM_BASE="https://api.tokenjuice.ai/v1"

# The key YOUR clients send to the gateway. Any string works; this is a shared
# secret between the gateway and your own machines.
NG_GATEWAY_KEY="NG-Claude-Anthropic"

# Port the gateway listens on.
NG_GATEWAY_PORT="4002"
